# ResearchPilot configuration — copy to .env and fill in real values.
# .env is gitignored; never commit real keys. The app reads OS environment
# variables only — export these (or use your shell's env-file mechanism).

# --- Search (Tavily, free tier: 1000 searches/month — https://app.tavily.com)
TAVILY_API_KEY=tvly-your-key-here
# Generic alternative; takes precedence when both are set
RESEARCHPILOT_SEARCH_API_KEY=
RESEARCHPILOT_SEARCH_PROVIDER=tavily
RESEARCHPILOT_SEARCH_MAX_RESULTS=8

# --- LLM (§18: provider behind one interface; "fake" = scripted, offline)
# Offline default — no key needed. The research-agent CLI rejects provider
# "fake" on purpose (exit 2): live runs must configure a real endpoint.
RESEARCHPILOT_LLM_PROVIDER=fake
RESEARCHPILOT_LLM_BASE_URL=
RESEARCHPILOT_LLM_MODEL=fake-model
RESEARCHPILOT_LLM_API_KEY=
RESEARCHPILOT_LLM_TIMEOUT=60.0

# Live example used for the sample transcripts (Groq, OpenAI-compatible,
# generous free tier — https://console.groq.com/keys). Uncomment and fill in:
# RESEARCHPILOT_LLM_PROVIDER=openai_compatible
# RESEARCHPILOT_LLM_BASE_URL=https://api.groq.com/openai/v1
# RESEARCHPILOT_LLM_MODEL=openai/gpt-oss-120b
# RESEARCHPILOT_LLM_API_KEY=gsk_your_key_here
# Any OpenAI-compatible endpoint works (OpenAI, Groq, Together, vLLM/Ollama,
# or Gemini's OpenAI-compatible layer) — only these four variables change.
# The app reads OS environment variables only; export these before running.

# --- Planning & execution
RESEARCHPILOT_MAX_PLAN_ATTEMPTS=3
RESEARCHPILOT_MAX_STEPS=12
RESEARCHPILOT_CANDIDATE_CAP=3
RESEARCHPILOT_MIN_EVIDENCE=3
RESEARCHPILOT_MIN_DISTINCT_SOURCES=2

# --- Retry policy
RESEARCHPILOT_RETRY_MAX_ATTEMPTS=3
RESEARCHPILOT_RETRY_BASE_DELAY=0.5
RESEARCHPILOT_RETRY_MAX_DELAY=8.0

# --- Output, memory, verbosity
RESEARCHPILOT_REPORT_DIR=reports
RESEARCHPILOT_MEMORY_PATH=data/researchpilot.db
RESEARCHPILOT_VERBOSE=false
RESEARCHPILOT_MEMORY=true
